cabal-version:      3.0
name:               circe
version:            0.1.0.0
synopsis:           CRC
description:        Cyclic-redundancy check
homepage:           github.com/dopamane/circe
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Codec
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

library
  default-language: Haskell2010
  ghc-options:      -Wall -Wunused-packages -O2
  hs-source-dirs:   lib
  exposed-modules:
    Codec.Circe.CRC16,
    Codec.Circe.CRC32,
    Codec.Circe.Cfg,
    Codec.Circe.Main,
    Codec.Circe.Pretty,
    Codec.Circe.Reflect
  build-depends:
    base < 5,
    bytestring,
    optparse-applicative,
    vector

executable crc
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded -with-rtsopts=-N
  hs-source-dirs:   exe
  main-is:          Main.hs
  build-depends:
    base < 5,
    circe

test-suite test
  default-language: Haskell2010
  ghc-options:      -Wall -Wunused-packages -O2 -threaded
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:
    Test.Circe
    Test.Circe.CRC16
    Test.Circe.CRC32
    Test.Circe.Reflect
  build-depends:
    base < 5,
    circe,
    tasty,
    tasty-hunit,
    vector
